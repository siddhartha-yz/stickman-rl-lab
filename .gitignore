*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.coverage
.coverage.*
htmlcov/

# Python environments and packaging
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
build/
dist/
*.whl
pip-wheel-metadata/

# Reinforcement-learning generated artifacts
checkpoints/**
!checkpoints/.gitkeep
logs/**
!logs/.gitkeep
trajectories/**
!trajectories/.gitkeep
videos/**
!videos/.gitkeep
lab/runs/**
!lab/runs/.gitkeep

# Curated report evidence: keep only durable, README/PROGRESS-linked artifacts
reports/**
!reports/agent-medium-lidar-seed17-comparison.json
!reports/distill-full-16.json
!reports/stage1-repeat4-reward.png
!reports/stage1-repeat4-success.png
!reports/stage3-full-breakthrough.json
!reports/stage3-full-recommended-detailed-seed1000.json
!reports/stage3-full-recommended-detailed-seed5000.json
!reports/desktop-smoke.json
!reports/desktop-training-console.png

